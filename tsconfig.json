{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
